{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=shortlink;Username=shortlink;Password="
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://shortlink@localhost:5672/",
    "Consumer": {
      "MaxRetryAttempts": 3,
      "InitialRetryDelayMs": 500,
      "MaxRetryDelayMs": 10000,
      "InitialConnectDelayMs": 1000,
      "MaxConnectDelayMs": 30000,
      "PrefetchCount": 10,
      "DeadLetterExchange": "clicks.dlx",
      "DeadLetterQueue": "clicks.dlq",
      "DeadLetterRoutingKey": "click.dead"
    }
  }
}
