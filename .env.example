# ===== ShortLink container env template (COPY to .env, jangan commit) =====
# Core
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=shortlink
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=shortlink
RABBITMQ_PASSWORD=CHANGE_ME_RABBIT
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# App / JWT / Admin seed (dibutuhkan service api)
JWT_SIGNING_KEY=CHANGE_ME_JWT_SIGNING_KEY_32BYTES_MIN
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@shortlink.dev
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PW
# Nama shared Docker network (harus ada / dibuat dulu)
SHARED_NETWORK=shared_bridge
